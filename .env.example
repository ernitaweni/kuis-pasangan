# Salin file ini menjadi .env.local, lalu isi nilainya dari
# Firebase Console → Project settings → Your apps → SDK setup and configuration.
# Nilai ini memang publik (ikut ke browser). Keamanan dijaga oleh Security Rules.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# true  = pakai Firebase Emulator lokal (jalankan `npm run emulators` dulu).
#         Nilai VITE_FIREBASE_* di atas boleh dikosongkan.
# false = pakai project Firebase asli.
VITE_USE_EMULATORS=true
